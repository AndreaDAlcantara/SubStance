# Supabase Postgres connection string. From the Supabase dashboard: click "Connect" (top of
# project page) and copy the URI.
#
# Use the "Session pooler" string (port 5432, no ?pgbouncer=true) for local dev — Prisma Migrate
# needs session-level features (advisory locks) that the Transaction pooler (port 6543) doesn't
# support, and `prisma migrate dev` will hang against it. Switch to the Transaction pooler only
# for serverless/edge production deploys (Fase 6), keeping migrations on a direct/session URL.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Resend (email notifications)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
